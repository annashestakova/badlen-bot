# ==========================================
# Telegram Bot
# ==========================================
# Получить у @BotFather → /newbot
BOT_TOKEN=1234567890:AAExample-Token-From-BotFather

# Случайная строка минимум 32 символа. Сгенерируй: python -c "import secrets; print(secrets.token_urlsafe(32))"
WEBHOOK_SECRET=замени-на-случайную-строку-32-символа-минимум

# URL твоего деплоя на Vercel (без слеша в конце)
WEBHOOK_URL=https://твой-проект.vercel.app

# Твой Telegram ID (узнать у @userinfobot). Несколько через запятую: [123,456]
ADMIN_IDS=[123456789]

# ==========================================
# Neon Postgres (https://neon.tech — бесплатный тир)
# ==========================================
# Формат: postgresql+asyncpg://user:pass@host/dbname?sslmode=require
DATABASE_URL=postgresql+asyncpg://user:password@ep-cool-host.eu-central-1.aws.neon.tech/capsula?ssl=require

# ==========================================
# Upstash Redis (https://upstash.com — бесплатный тир)
# ==========================================
# Из дашборда Upstash → REST API
UPSTASH_REDIS_REST_URL=https://example.upstash.io
UPSTASH_REDIS_REST_TOKEN=AYXxxx

# ==========================================
# Vercel Blob (хранилище фото)
# ==========================================
# Vercel Dashboard → Storage → Create Blob Store → Get token
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxx

# ==========================================
# Бизнес-настройки
# ==========================================
ATELIER_CITY=Брест
ATELIER_PHONE=+375 (29) 000-00-00
ATELIER_INSTAGRAM=https://instagram.com/your_atelier
