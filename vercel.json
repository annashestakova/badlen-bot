{
  "version": 2,
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb",
        "runtime": "python3.11"
      }
    }
  ],
  "routes": [
    { "src": "/api/webhook", "dest": "/api/index.py" },
    { "src": "/api/setup",   "dest": "/api/index.py" },
    { "src": "/api/health",  "dest": "/api/index.py" },
    { "src": "/(.*)",        "dest": "/api/index.py" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 30
    }
  }
}
